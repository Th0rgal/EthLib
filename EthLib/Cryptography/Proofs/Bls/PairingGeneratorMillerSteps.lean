    change (1 : ZMod Fp.modulus)⁻¹ = 1
    exact inv_one
  unfold Embedded.ofG1
  simp only [show G1.generator.isInfinity = false from by decide, Bool.false_eq_true,
    if_false, G1.toAffine, show G1.generator.z = Fp.one from rfl,
    show Fp.one.isZero = false from rfl, hi]
  decide +kernel
